{% liquid
  if section.settings.hero_image != blank
    assign hero_url = section.settings.hero_image | image_url: width: 3000
  else
    assign hero_url = 'https://cdn.shopify.com/s/files/1/0699/9664/2417/files/calico-rich-johnson-homepage-hero-v2.png?v=1786967143'
  endif
%}

{% style %}
  @font-face {
    font-family: "Mirage Slab";
    src: url("https://cdn.shopify.com/s/files/1/0699/9664/2417/files/mirage-slab-regular.ttf?v=1786833624") format("truetype");
    font-display: swap;
  }

  #CalicoHero-{{ section.id }} {
    --hero-height: {{ section.settings.desktop_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    --hero-overlap: {{ section.settings.header_overlap }}px;
    --hero-overlay: {{ section.settings.overlay_strength | divided_by: 100.0 }};
    --hero-content-width: {{ section.settings.content_width }}px;
    --hero-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-subheading-size: {{ section.settings.subheading_size }}px;
    --hero-body-size: {{ section.settings.body_size }}px;
    --hero-button-size: {{ section.settings.button_size }}px;
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-accent-color: {{ section.settings.accent_color }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-button-background: {{ section.settings.button_background }};
    --hero-button-color: {{ section.settings.button_color }};
    --hero-button-border: {{ section.settings.button_border }};
    position: relative;
    min-height: var(--hero-height);
    margin-top: calc(var(--hero-overlap) * -1);
    overflow: hidden;
    background: #160d08;
  }

  #CalicoHero-{{ section.id }} .calico-hero__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
  }

  #CalicoHero-{{ section.id }}::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10, 6, 3, .82) 0%, rgba(10, 6, 3, .56) 31%, rgba(10, 6, 3, .12) 57%, transparent 76%),
      linear-gradient(rgba(10, 6, 3, var(--hero-overlay)), rgba(10, 6, 3, var(--hero-overlay)));
    content: "";
    pointer-events: none;
  }

  #CalicoHero-{{ section.id }}::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    height: 24%;
    background: linear-gradient(transparent, rgba(10, 6, 3, .28));
    content: "";
    pointer-events: none;
  }

  #CalicoHero-{{ section.id }} .calico-hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    width: min(1440px, calc(100% - 48px));
    min-height: var(--hero-height);
    align-items: center;
    margin: 0 auto;
    padding-top: calc(var(--hero-overlap) + 24px);
    padding-bottom: 42px;
  }

  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    position: absolute;
    inset: 0;
    z-index: 710;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    clip-path: ellipse(10% 18% at 73% 14%);
    -webkit-mask-image: radial-gradient(ellipse 11% 19% at 73% 14%, #000 64%, transparent 84%);
    mask-image: radial-gradient(ellipse 11% 19% at 73% 14%, #000 64%, transparent 84%);
    pointer-events: none;
  }

  #CalicoHero-{{ section.id }} .calico-hero__copy {
    width: min(100%, var(--hero-content-width));
    color: var(--hero-text-color);
    text-align: left;
    text-shadow: 0 2px 4px rgba(0, 0, 0, .8);
  }

  #CalicoHero-{{ section.id }} .calico-hero__eyebrow {
    margin: 0 0 12px;
    color: var(--hero-accent-color);
    font-family: {% if section.settings.eyebrow_font == 'mirage' %}"Mirage Slab",{% elsif section.settings.eyebrow_font == 'theme' %}var(--font-heading-family),{% elsif section.settings.eyebrow_font == 'georgia' %}Georgia,{% endif %} Rockwell, Georgia, serif;
    font-size: var(--hero-eyebrow-size);
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #CalicoHero-{{ section.id }} .calico-hero__heading {
    max-width: 620px;
    margin: 0;
    color: var(--hero-heading-color);
    font-family: {% if section.settings.heading_font == 'calico' %}"Calico Bones",{% elsif section.settings.heading_font == 'mirage' %}"Mirage Slab",{% elsif section.settings.heading_font == 'rye' %}Rye,{% endif %} Rockwell, Georgia, serif;
    font-size: clamp(48px, 5.3vw, var(--hero-heading-size));
    font-weight: 900;
    letter-spacing: .01em;
    line-height: .93;
    text-transform: uppercase;
    text-shadow: 0 3px 0 rgba(52, 27, 13, .7), 0 6px 12px rgba(0, 0, 0, .75);
  }

  #CalicoHero-{{ section.id }} .calico-hero__rule {
    display: flex;
    width: min(390px, 82%);
    align-items: center;
    gap: 12px;
    margin: 22px 0;
    color: var(--hero-accent-color);
  }

  #CalicoHero-{{ section.id }} .calico-hero__rule::before,
  #CalicoHero-{{ section.id }} .calico-hero__rule::after {
    height: 2px;
    flex: 1;
    background: currentColor;
    content: "";
    box-shadow: 0 1px 2px rgba(0, 0, 0, .8);
  }

  #CalicoHero-{{ section.id }} .calico-hero__star {
    font-size: 19px;
    line-height: 1;
  }

  #CalicoHero-{{ section.id }} .calico-hero__subheading {
    max-width: 560px;
    margin: 0 0 14px;
    color: var(--hero-accent-color);
    font-family: {% if section.settings.subheading_font == 'mirage' %}"Mirage Slab",{% elsif section.settings.subheading_font == 'theme' %}var(--font-heading-family),{% elsif section.settings.subheading_font == 'georgia' %}Georgia,{% endif %} Rockwell, Georgia, serif;
    font-size: var(--hero-subheading-size);
    font-weight: 800;
    letter-spacing: .025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #CalicoHero-{{ section.id }} .calico-hero__text {
    max-width: 510px;
    margin: 0 0 28px;
    color: var(--hero-text-color);
    font-family: {% if section.settings.body_font == 'mirage' %}"Mirage Slab",{% elsif section.settings.body_font == 'theme' %}var(--font-body-family),{% elsif section.settings.body_font == 'georgia' %}Georgia,{% endif %} Arial, sans-serif;
    font-size: var(--hero-body-size);
    line-height: 1.5;
  }

  #CalicoHero-{{ section.id }} .calico-hero__button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 13px 28px;
    border: 2px solid var(--hero-button-border);
    border-radius: 2px;
    color: var(--hero-button-color);
    background: var(--hero-button-background);
    box-shadow: inset 0 0 0 2px rgba(255, 221, 153, .13), 0 4px 10px rgba(0, 0, 0, .5);
    font-family: {% if section.settings.button_font == 'mirage' %}"Mirage Slab",{% elsif section.settings.button_font == 'theme' %}var(--font-heading-family),{% elsif section.settings.button_font == 'georgia' %}Georgia,{% endif %} Rockwell, Georgia, serif;
    font-size: var(--hero-button-size);
    font-weight: 800;
    letter-spacing: .045em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .18s ease, filter .18s ease;
  }

  #CalicoHero-{{ section.id }} .calico-hero__button:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  @media screen and (max-width: 989px) {
    #CalicoHero-{{ section.id }}::before {
      background:
        linear-gradient(90deg, rgba(10, 6, 3, .78), rgba(10, 6, 3, .4) 58%, rgba(10, 6, 3, .12)),
        linear-gradient(rgba(10, 6, 3, var(--hero-overlay)), rgba(10, 6, 3, var(--hero-overlay)));
    }

    #CalicoHero-{{ section.id }} .calico-hero__copy { width: min(54%, var(--hero-content-width)); }
    #CalicoHero-{{ section.id }} .calico-hero__heading { font-size: clamp(42px, 7vw, 72px); }
  }

  @media screen and (max-width: 749px) {
    #CalicoHero-{{ section.id }} {
      min-height: var(--hero-mobile-height);
      margin-top: 0;
    }

    #CalicoHero-{{ section.id }} .calico-hero__image {
      object-position: {{ section.settings.mobile_image_position }}% center;
    }

    #CalicoHero-{{ section.id }} .calico-hero__head-layer {
      display: none;
    }

    #CalicoHero-{{ section.id }}::before {
      background: linear-gradient(90deg, rgba(10, 6, 3, .85), rgba(10, 6, 3, .36)), linear-gradient(0deg, rgba(10, 6, 3, .42), transparent 48%);
    }

    #CalicoHero-{{ section.id }} .calico-hero__content {
      width: calc(100% - 32px);
      min-height: var(--hero-mobile-height);
      align-items: flex-end;
      padding: 70px 0 38px;
    }

    #CalicoHero-{{ section.id }} .calico-hero__copy { width: 100%; }
    #CalicoHero-{{ section.id }} .calico-hero__eyebrow { font-size: min(var(--hero-eyebrow-size), 4vw); }
    #CalicoHero-{{ section.id }} .calico-hero__heading { max-width: 420px; font-size: clamp(40px, 13vw, 64px); }
    #CalicoHero-{{ section.id }} .calico-hero__subheading { max-width: 400px; font-size: min(var(--hero-subheading-size), 5vw); }
    #CalicoHero-{{ section.id }} .calico-hero__text { max-width: 390px; font-size: min(var(--hero-body-size), 4.2vw); }
  }

  /* CALICO REFERENCE PROPORTION PASS */
  #CalicoHero-{{ section.id }} .calico-hero__image,
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    transform: scale(.92);
    transform-origin: right center;
  }
  #CalicoHero-{{ section.id }} .calico-hero__content {
    width: min(1184px, calc(100% - 80px));
  }
  #CalicoHero-{{ section.id }} .calico-hero__copy {
    width: min(100%, 620px);
  }
  #CalicoHero-{{ section.id }} .calico-hero__eyebrow {
    font-size: calc(var(--hero-eyebrow-size) * 1.18);
  }
  #CalicoHero-{{ section.id }} .calico-hero__heading {
    max-width: 650px;
    font-size: clamp(64px, 6.4vw, calc(var(--hero-heading-size) * 1.2));
  }
  #CalicoHero-{{ section.id }} .calico-hero__subheading {
    max-width: 610px;
    font-size: calc(var(--hero-subheading-size) * 1.16);
  }
  #CalicoHero-{{ section.id }} .calico-hero__text {
    max-width: 540px;
    font-size: calc(var(--hero-body-size) * 1.1);
  }
  #CalicoHero-{{ section.id }} .calico-hero__button {
    font-size: calc(var(--hero-button-size) * 1.08);
  }
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    clip-path: ellipse(7.2% 14.5% at 74% 12.5%);
    -webkit-mask-image: radial-gradient(ellipse 7.4% 14.7% at 74% 12.5%, #000 97%, transparent 100%);
    mask-image: radial-gradient(ellipse 7.4% 14.7% at 74% 12.5%, #000 97%, transparent 100%);
  }
  @media screen and (max-width: 989px) {
    #CalicoHero-{{ section.id }} .calico-hero__content {
      width: calc(100% - 48px);
    }
  }
  @media screen and (max-width: 749px) {
    #CalicoHero-{{ section.id }} .calico-hero__image {
      transform: none;
    }
    #CalicoHero-{{ section.id }} .calico-hero__content {
      width: calc(100% - 32px);
    }
  }


  /* CALICO FULL HEAD RESTORE */
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    clip-path: ellipse(8.8% 18.5% at 74% 10.5%);
    -webkit-mask-image: radial-gradient(ellipse 9% 18.8% at 74% 10.5%, #000 94%, transparent 100%);
    mask-image: radial-gradient(ellipse 9% 18.8% at 74% 10.5%, #000 94%, transparent 100%);
  }

  /* CALICO PORTRAIT FIT CORRECTION */
  #CalicoHero-{{ section.id }} .calico-hero__image,
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    transform: scale(.88);
    transform-origin: right bottom;
  }
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    clip-path: ellipse(9.4% 21% at 74% 9%);
    -webkit-mask-image: radial-gradient(ellipse 9.7% 21.4% at 74% 9%, #000 95%, transparent 100%);
    mask-image: radial-gradient(ellipse 9.7% 21.4% at 74% 9%, #000 95%, transparent 100%);
  }
  @media screen and (max-width: 749px) {
    #CalicoHero-{{ section.id }} .calico-hero__image { transform: none; }
  }

  /* CALICO HEAD ABOVE HEADER LAYER */
  #CalicoHero-{{ section.id }} {
    overflow: visible;
  }
  #CalicoHero-{{ section.id }} .calico-hero__image {
    overflow: hidden;
    transform: translateY(-44px) scale(.88);
    transform-origin: right bottom;
  }
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    z-index: 900;
    transform: translateY(-44px) scale(.88);
    transform-origin: right bottom;
    clip-path: ellipse(9.5% 22% at 74% 9%);
    -webkit-mask-image: radial-gradient(ellipse 9.8% 22.4% at 74% 9%, #000 95%, transparent 100%);
    mask-image: radial-gradient(ellipse 9.8% 22.4% at 74% 9%, #000 95%, transparent 100%);
  }
  @media screen and (max-width: 749px) {
    #CalicoHero-{{ section.id }} { overflow: hidden; }
    #CalicoHero-{{ section.id }} .calico-hero__head-layer { display: none; }
  }

  /* CALICO HAIR CROP RESTORE */
  #CalicoHero-{{ section.id }} .calico-hero__image,
  #CalicoHero-{{ section.id }} .calico-hero__head-layer {
    object-position: {{ section.settings.image_position_x }}% 28%;
  }
{% endstyle %}

<section id="CalicoHero-{{ section.id }}" class="calico-hero">
  <img
    class="calico-hero__image"
    src="{{ hero_url }}"
    width="3000"
    height="2000"
    alt="{{ section.settings.image_alt | escape }}"
    fetchpriority="high"
  >

  <img
    class="calico-hero__head-layer"
    src="{{ hero_url }}"
    width="3000"
    height="2000"
    alt=""
    aria-hidden="true"
  >

  <div class="calico-hero__content">
    <div class="calico-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="calico-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="calico-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% endif %}

      {% if section.settings.show_rule %}
        <div class="calico-hero__rule" aria-hidden="true"><span class="calico-hero__star">★</span></div>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <h2 class="calico-hero__subheading">{{ section.settings.subheading | escape | newline_to_br }}</h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="calico-hero__text">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="calico-hero__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          {{ section.settings.button_label | escape }} <span aria-hidden="true">&nbsp;→</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Calico Rich Hero",
  "tag": "section",
  "class": "section section--calico-hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Rich Johnson hand-routing a custom wood sign in the Calico Wood Signs workshop" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 520, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 520, "max": 900, "step": 20, "unit": "px", "default": 700 },
    { "type": "range", "id": "header_overlap", "label": "Overlap into header", "min": 0, "max": 180, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "image_position_x", "label": "Image horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_position_y", "label": "Image vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 },
    { "type": "range", "id": "mobile_image_position", "label": "Mobile horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 67 },
    { "type": "range", "id": "overlay_strength", "label": "Image darkness", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 5 },
    { "type": "range", "id": "content_width", "label": "Text area width", "min": 360, "max": 700, "step": 20, "unit": "px", "default": 560 },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "CALICO WOOD SIGNS" },
    { "type": "select", "id": "eyebrow_font", "label": "Small heading lettering", "default": "mirage", "options": [{ "value": "mirage", "label": "Mirage Slab" }, { "value": "rockwell", "label": "Rockwell" }, { "value": "georgia", "label": "Georgia" }, { "value": "theme", "label": "Theme heading" }] },
    { "type": "range", "id": "eyebrow_size", "label": "Small heading size", "min": 10, "max": 36, "step": 1, "unit": "px", "default": 18 },
    { "type": "textarea", "id": "heading", "label": "Main heading", "default": "CUSTOM\nWOOD SIGNS" },
    { "type": "select", "id": "heading_font", "label": "Heading lettering", "default": "mirage", "options": [{ "value": "calico", "label": "Calico Bones" }, { "value": "mirage", "label": "Mirage Slab" }, { "value": "rye", "label": "Rye" }, { "value": "rockwell", "label": "Rockwell" }] },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 54, "max": 120, "step": 2, "unit": "px", "default": 86 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#f4ead8" },
    { "type": "checkbox", "id": "show_rule", "label": "Show line and star", "default": true },
    { "type": "textarea", "id": "subheading", "label": "Gold subheading", "default": "HAND-CARVED. HAND-PAINTED.\nMADE THE OLD-SCHOOL WAY." },
    { "type": "select", "id": "subheading_font", "label": "Gold subheading lettering", "default": "mirage", "options": [{ "value": "mirage", "label": "Mirage Slab" }, { "value": "rockwell", "label": "Rockwell" }, { "value": "georgia", "label": "Georgia" }, { "value": "theme", "label": "Theme heading" }] },
    { "type": "range", "id": "subheading_size", "label": "Gold subheading size", "min": 14, "max": 44, "step": 1, "unit": "px", "default": 25 },
    { "type": "richtext", "id": "body", "label": "Description", "default": "<p>Every sign we make is crafted by hand using time-honored techniques and quality materials built to last.</p>" },
    { "type": "select", "id": "body_font", "label": "Description lettering", "default": "theme", "options": [{ "value": "theme", "label": "Theme body" }, { "value": "mirage", "label": "Mirage Slab" }, { "value": "rockwell", "label": "Rockwell" }, { "value": "georgia", "label": "Georgia" }] },
    { "type": "range", "id": "body_size", "label": "Description size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 19 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP CUSTOM SIGNS" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_font", "label": "Button lettering", "default": "mirage", "options": [{ "value": "mirage", "label": "Mirage Slab" }, { "value": "rockwell", "label": "Rockwell" }, { "value": "georgia", "label": "Georgia" }, { "value": "theme", "label": "Theme heading" }] },
    { "type": "range", "id": "button_size", "label": "Button text size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#d99b3d" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#f4ead8" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#5a160f" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#fff2dc" },
    { "type": "color", "id": "button_border", "label": "Button border", "default": "#b66d2c" }
  ],
  "presets": [{ "name": "Calico Rich Hero" }]
}
{% endschema %}
